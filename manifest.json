{
  "manifest_version": 3,
  "name": "LeetRepeat",
  "version": "1.1.0",
  "description": "A focused spaced-repetition dashboard for LeetCode problems.",
  "permissions": ["storage", "notifications", "alarms"],
  "host_permissions": ["https://leetcode.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LeetRepeat"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
